# penumbra_embed_files(<output.cpp> <symbol> <file> [<symbol> <file> ...])
# Writes a C++ source that holds each file's bytes as `extern const unsigned char <symbol>[]` with
# `extern const unsigned int <symbol>Size`. Used for data the executables must carry with them (UI fonts),
# so nothing has to be found on disk at run time. Regenerated when an input changes.
function(penumbra_embed_files output)
    set(content "// Generated by cmake/EmbedFile.cmake. Do not edit.\n")
    set(arguments ${ARGN})
    list(LENGTH arguments count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 2)
        math(EXPR fileIndex "${index} + 1")
        list(GET arguments ${index} symbol)
        list(GET arguments ${fileIndex} file)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hexLength)
        math(EXPR size "${hexLength} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        string(APPEND content "extern const unsigned char ${symbol}[];\nextern const unsigned int ${symbol}Size;\n")
        string(APPEND content "alignas(4) const unsigned char ${symbol}[] = {\n${bytes}\n};\nconst unsigned int ${symbol}Size = ${size};\n\n")
    endforeach()
    # Only rewrite when the bytes changed, so a reconfigure does not rebuild the target.
    if(EXISTS "${output}")
        file(READ "${output}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${output}" "${content}")
endfunction()
