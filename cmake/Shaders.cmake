# Offline HLSL -> DXIL compilation. Every shader permutation is compiled with DXC
# into a C header containing the bytecode, and all of them are registered in a
# generated ShaderRegistry.cpp so the engine never loads shader files from disk.
#
# penumbra_compile_shaders(
#     TARGET <target>
#     SOURCE_DIR <dir with .hlsl files>
#     SHADERS "<Name>|<file.hlsl>|<entry>|<profile>[|DEFINE=1;DEFINE2=0]" ...)

function(penumbra_compile_shaders)
    cmake_parse_arguments(ARG "" "TARGET;SOURCE_DIR" "SHADERS" ${ARGN})

    set(outDir "${CMAKE_CURRENT_BINARY_DIR}/ShaderBlobs")
    file(MAKE_DIRECTORY "${outDir}")
    file(GLOB includeDeps "${ARG_SOURCE_DIR}/*.hlsli")

    set(headers "")
    set(registryIncludes "")
    set(registryEntries "")

    foreach(spec IN LISTS ARG_SHADERS)
        string(REPLACE "|" ";" parts "${spec}")
        list(LENGTH parts partCount)
        list(GET parts 0 name)
        list(GET parts 1 file)
        list(GET parts 2 entry)
        list(GET parts 3 profile)
        set(defineArgs "")
        if(partCount GREATER 4)
            list(GET parts 4 defines)
            string(REPLACE "," ";" defineList "${defines}")
            foreach(def IN LISTS defineList)
                list(APPEND defineArgs "-D" "${def}")
            endforeach()
        endif()

        set(header "${outDir}/${name}.h")
        add_custom_command(
            OUTPUT "${header}"
            COMMAND "${PENUMBRA_DXC_EXECUTABLE}"
                -nologo -T ${profile} -E ${entry} -HV 2021 -O3 -WX
                -Qstrip_reflect
                -I "${ARG_SOURCE_DIR}"
                ${defineArgs}
                -Fh "${header}" -Vn "g_Shader_${name}"
                "${ARG_SOURCE_DIR}/${file}"
            DEPENDS "${ARG_SOURCE_DIR}/${file}" ${includeDeps}
            COMMENT "DXC ${name} (${file}:${entry} ${profile})"
            VERBATIM)
        list(APPEND headers "${header}")
        string(APPEND registryIncludes "#include \"${name}.h\"\n")
        string(APPEND registryEntries "\t\t{ \"${name}\", g_Shader_${name}, sizeof(g_Shader_${name}) },\n")
    endforeach()

    set(registryCpp "${outDir}/ShaderRegistry.cpp")
    file(CONFIGURE OUTPUT "${registryCpp}.in" CONTENT
"// Generated by cmake/Shaders.cmake - do not edit.
#include \"Penumbra/Renderer/ShaderLibrary.h\"

#include <cstdint>
#include <cstring>

typedef unsigned char BYTE;

@registryIncludes@
namespace Penumbra {

	namespace {
		struct ShaderEntry
		{
			const char* Name;
			const BYTE* Data;
			size_t Size;
		};

		const ShaderEntry s_Shaders[] = {
@registryEntries@			{ nullptr, nullptr, 0 },
		};
	}

	ShaderBytecode ShaderLibrary::Find(const char* name)
	{
		for (const ShaderEntry& entry : s_Shaders)
		{
			if (entry.Name && std::strcmp(entry.Name, name) == 0)
				return { entry.Data, entry.Size };
		}
		return {};
	}

}
" @ONLY)
    # Only touch the real file when its content changes, to avoid needless rebuilds.
    file(GENERATE OUTPUT "${registryCpp}" INPUT "${registryCpp}.in")

    target_sources(${ARG_TARGET} PRIVATE "${registryCpp}" ${headers})
    target_include_directories(${ARG_TARGET} PRIVATE "${outDir}")
endfunction()
