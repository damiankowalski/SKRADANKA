root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hlsl,hlsli}]
indent_style = tab
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{lua,json,pscene,pprefab,yml,md,py}]
indent_style = space
indent_size = 4

[*.{yml,json,pscene,pprefab}]
indent_size = 2
