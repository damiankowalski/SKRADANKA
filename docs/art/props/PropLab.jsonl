# Prop lab: renders Scenes/PropLab.pscene, every family of generated props (Tools/PropGen) under the game's light.
# Rows from the back (-Z): doors, shelves, wine racks, crates, barrels, chests, tables, chairs, stools, benches.
# Run from the repository root:
#   PenumbraEditor --headless --exec docs/art/props/PropLab.jsonl --project DemoProject
{"cmd": "scene.open", "path": "Scenes/PropLab.pscene"}
{"cmd": "play"}
{"cmd": "simulate", "seconds": 0.5}
{"cmd": "render.screenshot", "path": "docs/art/props/proplab_wide.png", "width": 1600, "height": 900, "camera": {"position": [0.0, 7.5, 15.0], "target": [0.0, 0.3, -1.0], "fov": 60}}
{"cmd": "render.screenshot", "path": "docs/art/props/proplab_doors_shelves.png", "width": 1280, "height": 720, "camera": {"position": [0.0, 1.8, -3.6], "target": [0.0, 1.0, -9.0], "fov": 60}}
{"cmd": "render.screenshot", "path": "docs/art/props/proplab_crates_barrels.png", "width": 1280, "height": 720, "camera": {"position": [0.5, 1.7, 2.6], "target": [0.0, 0.4, -2.2], "fov": 60}}
{"cmd": "render.screenshot", "path": "docs/art/props/proplab_furniture.png", "width": 1280, "height": 720, "camera": {"position": [-0.8, 1.8, 12.4], "target": [0.0, 0.4, 5.0], "fov": 60}}
