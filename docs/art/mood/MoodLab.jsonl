# Mood lab: renders Scenes/MoodLab.pscene in four lighting variants, two shots each (docs/art/mood/README.md).
# Run from the repository root:
#   PenumbraEditor --headless --exec docs/art/mood/MoodLab.jsonl --project DemoProject
# The variants' values live in DemoProject/Assets/Scripts/MoodLab/Variants.lua. Simulation steps are fixed
# (dt 1/60) and the scene's seed is fixed, so a rerun on the same machine gives the same frames.
{"cmd": "scene.open", "path": "Scenes/MoodLab.pscene"}
{"cmd": "play"}
{"cmd": "simulate", "seconds": 1.0}
# 0. Base: the cloister's torches and environment as they are today.
{"cmd": "script.exec", "code": "return require('Scripts/MoodLab/Variants').apply('Base')"}
{"cmd": "simulate", "frames": 6}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/0_base_wide.png", "width": 1280, "height": 720, "camera": {"position": [0.0, 2.0, 7.3], "target": [0.0, 1.0, -8.0], "fov": 75}}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/0_base_close.png", "width": 1280, "height": 720, "camera": {"position": [1.2, 1.5, -9.1], "target": [6.0, 1.1, -9.7], "fov": 55}}
# A. Fire: thick fog, near-black world, torches and fire baskets.
{"cmd": "script.exec", "code": "return require('Scripts/MoodLab/Variants').apply('Fire')"}
{"cmd": "simulate", "frames": 6}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/A_fire_wide.png", "width": 1280, "height": 720, "camera": {"position": [0.0, 2.0, 7.3], "target": [0.0, 1.0, -8.0], "fov": 75}}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/A_fire_close.png", "width": 1280, "height": 720, "camera": {"position": [1.2, 1.5, -9.1], "target": [6.0, 1.1, -9.7], "fov": 55}}
# B. Astral: the same fog, only astral lamps.
{"cmd": "script.exec", "code": "return require('Scripts/MoodLab/Variants').apply('Astral')"}
{"cmd": "simulate", "frames": 6}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/B_astral_wide.png", "width": 1280, "height": 720, "camera": {"position": [0.0, 2.0, 7.3], "target": [0.0, 1.0, -8.0], "fov": 75}}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/B_astral_close.png", "width": 1280, "height": 720, "camera": {"position": [1.2, 1.5, -9.1], "target": [6.0, 1.1, -9.7], "fov": 55}}
# C. Mixed: fire in the east, astral lamps in the west, darkness between.
{"cmd": "script.exec", "code": "return require('Scripts/MoodLab/Variants').apply('Mixed')"}
{"cmd": "simulate", "frames": 6}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/C_mixed_wide.png", "width": 1280, "height": 720, "camera": {"position": [0.0, 2.0, 7.3], "target": [0.0, 1.0, -8.0], "fov": 75}}
{"cmd": "render.screenshot", "path": "docs/art/mood/v1/C_mixed_close.png", "width": 1280, "height": 720, "camera": {"position": [1.2, 1.5, -9.1], "target": [6.0, 1.1, -9.7], "fov": 55}}
{"cmd": "stop"}
